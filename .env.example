APP_ENV=development               # development | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me
EMAIL_HASH_KEY=                   # ключ HMAC для поиска по email: python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_ENCRYPTION_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/happiness

# ЮKassa — ТОЛЬКО тестовый магазин, пока владелец не скажет иначе
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=              # test_... ; пусто → мок ЮKassa (только не production)
YOOKASSA_ALLOW_LIVE=false         # боевой ключ (без test_) — только по явному решению владельца

# LLM
LLM_PROVIDER=yandexgpt            # yandexgpt | gigachat | mock (мок — не в production)
YANDEXGPT_API_KEY=                # пусто → мок LLM (вне production)
YANDEXGPT_FOLDER_ID=
GIGACHAT_AUTH_KEY=                # ключ авторизации (Basic) из личного кабинета
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE=               # путь к сертификату НУЦ Минцифры, если его нет в системе

# Почта для ссылок на отчёт (пусто → письма в dev-outbox, вне production)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

YANDEX_METRIKA_ID=
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
INTERNAL_LINK_TOKEN=              # секрет ссылки /internal/<токен> — помечает браузер как внутренний

# Порты на хосте для docker compose (если 5432/8000 заняты другими проектами)
DB_PORT=5432
APP_PORT=8000
