# Скопируй в .env: cp .env.example .env
# Без единого ключа всё работает на моках: оплата, LLM, письма, Метрика выключена.

# ── Приложение ─────────────────────────────────────────────────────────────
# Публичный адрес сайта: ссылки в шеринге, письмах, return_url оплаты. В проде — https://<домен>
APP_URL=http://localhost:3000
# Адрес для внутренних запросов приложения к самому себе (мок-касса шлёт вебхук). В Docker задан в compose.
APP_INTERNAL_URL=
# SQLite. Локально — файл в ./data, в Docker — /data/app.db (том)
DATABASE_URL=file:./data/app.db
# Пересоздавать 500 синтетических результатов для перцентиля при старте контейнера
SEED_ON_START=true

# ── Админка /admin и /dev/* (basic auth: логин любой, пароль ниже). Пусто — админка выключена ──
# В production: не короче 16 символов и не из списка простых, иначе приложение не стартует.
# Сгенерировать: openssl rand -base64 24
ADMIN_PASSWORD=change-me

# ── Поддержка: футер, письмо с разбором, страница разбора, оферта, экраны ожидания ──
# SUPPORT_EMAIL обязателен в production
SUPPORT_EMAIL=
# Необязательно: @username или ссылка t.me/...
SUPPORT_TELEGRAM=

# В production приложение не стартует, если касса mock, пароль слабый или нет SUPPORT_EMAIL.
# true отключает эти проверки — ТОЛЬКО для CI и локального прогона production-сборки на моках.
UNSAFE_SKIP_PRODUCTION_CHECKS=false

# ── Оплата ────────────────────────────────────────────────────────────────
# mock — своя «тестовая касса» /pay/mock/... ; yookassa — настоящая ЮKassa
PAYMENT_PROVIDER=mock
# Подпись вебхуков мок-кассы (любая строка)
MOCK_WEBHOOK_SECRET=dev-mock-secret
# ЮKassa: личный кабинет → Интеграция → Ключи API. Тестовый магазин даёт ключ test_...
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ: none — данные чека в платёж не передаются (самозанятый, чек в «Мой налог» формирует ЮKassa);
# yookassa_receipt — чек передаётся в платеже («Чеки от ЮKassa» / своя касса). Что выбрать — LAUNCH.md
RECEIPT_MODE=none
# Код ставки НДС в чеке (только для yookassa_receipt; 1 — без НДС). Согласуй с бухгалтером
YOOKASSA_VAT_CODE=1

# ── LLM для полного отчёта ────────────────────────────────────────────────
# mock — шаблоны (по умолчанию); openai | yandexgpt — внешняя модель, при ошибке — fallback на mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Совместимый с OpenAI API шлюз (по желанию)
OPENAI_BASE_URL=https://api.openai.com/v1
# YandexGPT: сервисный аккаунт с ролью ai.languageModels.user, API-ключ и id каталога
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
# Модель и версия: yandexgpt/latest, yandexgpt/rc, yandexgpt-lite/latest ...
YANDEXGPT_MODEL=yandexgpt/latest

# ── Письма со ссылкой на отчёт ────────────────────────────────────────────
# mock — письмо не отправляется, в лог пишется факт отправки; smtp — настоящая почта
MAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Индекс счастья <hello@example.ru>"

# ── Аналитика ─────────────────────────────────────────────────────────────
# Номер счётчика Яндекс Метрики. Пусто — Метрика выключена. Грузится только после согласия на cookie
YM_COUNTER_ID=

# ── Docker / HTTPS ────────────────────────────────────────────────────────
APP_PORT=3000
# Домен для Caddy (профиль https)
DOMAIN=
